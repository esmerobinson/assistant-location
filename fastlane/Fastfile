default_platform(:ios)

PROFILE_NAME = "AssistantLocation AppStore"
APP_ID = "com.oliverullman.assistantlocation"
EXT_ID = "#{APP_ID}.share"
EXT_PROFILE_NAME = "AssistantLocation Share AppStore"
ADHOC_PROFILE_NAME = "AssistantLocation AdHoc"
EXT_ADHOC_PROFILE_NAME = "AssistantLocation Share AdHoc"
VOICE_ID = "#{APP_ID}.voice"
VOICE_PROFILE_NAME = "AssistantLocation Voice AppStore"
VOICE_ADHOC_PROFILE_NAME = "AssistantLocation Voice AdHoc"
CTL_ID = "#{APP_ID}.journalcontrol"
CTL_PROFILE_NAME = "AssistantLocation JournalControl AppStore"
CTL_ADHOC_PROFILE_NAME = "AssistantLocation JournalControl AdHoc"
TEAM_ID = "J66WVM2DTX"
INTERNAL_GROUP = "Internal"
ADHOC_OUTPUT_DIR = "build/adhoc"
LISTEN_ID = "com.oliverullman.listen"
LISTEN_ADHOC_PROFILE_NAME = "Listen AdHoc"
LISTEN_ADHOC_OUTPUT_DIR = "build/adhoc-listen"
QUOTES_ID = "com.oliverullman.quotes"
QUOTES_ADHOC_PROFILE_NAME = "Quotes AdHoc"
QUOTES_WIDGET_ID = "#{QUOTES_ID}.widget"
QUOTES_WIDGET_ADHOC_PROFILE_NAME = "Quotes Widget AdHoc"
QUOTES_ADHOC_OUTPUT_DIR = "build/adhoc-quotes"
MARKETPLACE_ID = "com.oliverullman.marketplace"
MARKETPLACE_ADHOC_PROFILE_NAME = "Marketplace AdHoc"
MARKETPLACE_ADHOC_OUTPUT_DIR = "build/adhoc-marketplace"
GRIPES_ID = "com.oliverullman.gripes"
GRIPES_ADHOC_PROFILE_NAME = "Gripes AdHoc"
GRIPES_ADHOC_OUTPUT_DIR = "build/adhoc-gripes"
CYCLE_ID = "com.oliverullman.cycle"
CYCLE_ADHOC_PROFILE_NAME = "Cycle AdHoc"
CYCLE_ADHOC_OUTPUT_DIR = "build/adhoc-cycle"
CYCLE_APPSTORE_PROFILE_NAME = "Cycle AppStore"
# Notification Service Extension that reports push delivery to the box (CycleNSE/). Embedded in the
# app, so it needs its own app id and profiles; no capabilities of its own.
CYCLE_NSE_ID = "#{CYCLE_ID}.nse"
CYCLE_NSE_ADHOC_PROFILE_NAME = "Cycle NSE AdHoc"
CYCLE_NSE_APPSTORE_PROFILE_NAME = "Cycle NSE AppStore"
CYCLE_GROUP = "Cycle Testers"
DUESPIKE_ID = "com.oliverullman.duespike"
DUESPIKE_NSE_ID = "#{DUESPIKE_ID}.nse"
DUESPIKE_ADHOC_PROFILE_NAME = "DueSpike AdHoc"
DUESPIKE_NSE_ADHOC_PROFILE_NAME = "DueSpike NSE AdHoc"
DUESPIKE_ADHOC_OUTPUT_DIR = "build/adhoc-duespike"
GOALS_ID = "com.oliverullman.goals"
GOALS_APPSTORE_PROFILE_NAME = "Goals AppStore"
GOALS_GROUP = "Goals Testers"
# The guest copy of Listen: same Listen target and scheme, its own bundle id, page URL and passcode cookie.
LISTEN_GUEST_ID = "com.oliverullman.listenguest"
LISTEN_GUEST_APPSTORE_PROFILE_NAME = "Listen Guest AppStore"
LISTEN_GUEST_GROUP = "Listen Testers"

platform :ios do
  desc "Build signed (manual, pre-imported cert+profile) and upload to TestFlight"
  lane :beta do
    cocoapods

    api_key = asc_api_key
    ensure_ext_bundle_id

    [[EXT_ID, EXT_PROFILE_NAME], [VOICE_ID, VOICE_PROFILE_NAME],
     [CTL_ID, CTL_PROFILE_NAME]].each do |identifier, name|
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: identifier,
        provisioning_name: name,
        team_id: TEAM_ID,
        readonly: false,
      )
    end

    build_number = stamp_build_number

    build_app(
      workspace: "Overland.xcworkspace",
      scheme: "Overland",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          APP_ID => PROFILE_NAME,
          EXT_ID => EXT_PROFILE_NAME,
          VOICE_ID => VOICE_PROFILE_NAME,
          CTL_ID => CTL_PROFILE_NAME,
        },
      },
      # PROVISIONING_PROFILE_SPECIFIER is deliberately NOT passed here: an
      # xcargs value applies to every target, which would hand the app's profile
      # to the extension. Each target carries its own specifier in the project.
      xcargs: "CODE_SIGN_STYLE=Manual " \
              "DEVELOPMENT_TEAM=#{TEAM_ID} " \
              "CODE_SIGN_IDENTITY='Apple Distribution'",
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      skip_waiting_for_build_processing: true,
    )

    # A build that belongs to no beta group is invisible to every tester, even
    # once it processes to VALID. `upload_to_testflight` only assigns groups
    # when it waits for processing, and waiting costs 10-20 macOS runner
    # minutes per build, so the group is assigned here instead: the build
    # resource shows up in the API within a minute or two of the upload, long
    # before processing finishes, and a group assigned while it is still
    # PROCESSING takes effect the moment it goes VALID.
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    group = app.get_beta_groups.find { |g| g.name == INTERNAL_GROUP }
    UI.user_error!("No beta group named #{INTERNAL_GROUP.inspect} on #{APP_ID}") unless group

    build = nil
    30.times do
      build = Spaceship::ConnectAPI::Build.all(
        app_id: app.id, build_number: build_number,
      ).first
      break if build
      sleep(20)
    end
    UI.user_error!("Build #{build_number} never appeared in App Store Connect") unless build

    build.add_beta_groups(beta_groups: [group])
    UI.success("Build #{build_number} assigned to beta group #{INTERNAL_GROUP.inspect}")
  end

  desc "Build an ad-hoc signed ipa for over-the-air install on the registered device"
  lane :adhoc do
    cocoapods

    api_key = asc_api_key
    ensure_ext_bundle_id

    # The ad hoc profiles already exist in App Store Connect; these calls find
    # and download them. readonly stays false so a newly registered device can
    # be folded in by regenerating the profile.
    [[APP_ID, ADHOC_PROFILE_NAME], [EXT_ID, EXT_ADHOC_PROFILE_NAME],
     [VOICE_ID, VOICE_ADHOC_PROFILE_NAME], [CTL_ID, CTL_ADHOC_PROFILE_NAME]].each do |identifier, name|
      get_provisioning_profile(
        api_key: api_key,
        adhoc: true,
        app_identifier: identifier,
        provisioning_name: name,
        team_id: TEAM_ID,
        # fastlane rejects :force alongside an explicit :readonly (even false).
        # Always regenerate: sigh's reuse-if-covers-all-devices check kept
        # serving stale profiles (missing aps-environment on the app, missing a
        # newly registered device on the extensions).
        force: true,
      )
    end

    stamp_build_number

    # export_options only governs the export step; the ARCHIVE step signs with
    # the PROVISIONING_PROFILE_SPECIFIER committed in the pbxproj, which names
    # the App Store profiles and is not installed on this runner. Rewrite the
    # specifier per target — xcargs cannot do this, because one xcargs value
    # applies to every target and would hand the app's profile to the extension.
    # This edits the pbxproj on the runner only; it is never committed.
    {
      "Overland" => ADHOC_PROFILE_NAME,
      "ShareToDesktop" => EXT_ADHOC_PROFILE_NAME,
      "VoiceToDesktop" => VOICE_ADHOC_PROFILE_NAME,
      "JournalControl" => CTL_ADHOC_PROFILE_NAME,
    }.each do |target, profile|
      update_code_signing_settings(
        path: "Overland.xcodeproj",
        targets: [target],
        use_automatic_signing: false,
        team_id: TEAM_ID,
        code_sign_identity: "Apple Distribution",
        profile_name: profile,
      )
    end

    build_app(
      workspace: "Overland.xcworkspace",
      scheme: "Overland",
      export_method: "ad-hoc",
      output_directory: ADHOC_OUTPUT_DIR,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          APP_ID => ADHOC_PROFILE_NAME,
          EXT_ID => EXT_ADHOC_PROFILE_NAME,
          VOICE_ID => VOICE_ADHOC_PROFILE_NAME,
          CTL_ID => CTL_ADHOC_PROFILE_NAME,
        },
      },
      # See the note in `beta`: an xcargs specifier would apply to every target.
      xcargs: "CODE_SIGN_STYLE=Manual " \
              "DEVELOPMENT_TEAM=#{TEAM_ID} " \
              "CODE_SIGN_IDENTITY='Apple Distribution'",
    )

    UI.success("Ad hoc ipa: #{lane_context[SharedValues::IPA_OUTPUT_PATH]}")
  end

  desc "Build the standalone Listen app as an ad-hoc signed ipa (no Pods, no extensions)"
  lane :listen_adhoc do
    api_key = asc_api_key

    Spaceship::ConnectAPI.auth(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key: ENV["ASC_KEY_P8"],
    )
    if Spaceship::ConnectAPI::BundleId.find(LISTEN_ID)
      UI.message("Bundle id #{LISTEN_ID} is already registered")
    else
      Spaceship::ConnectAPI::BundleId.create(
        name: "Listen",
        identifier: LISTEN_ID,
        platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
      )
      UI.success("Registered bundle id #{LISTEN_ID}")
    end

    get_provisioning_profile(
      api_key: api_key,
      adhoc: true,
      app_identifier: LISTEN_ID,
      provisioning_name: LISTEN_ADHOC_PROFILE_NAME,
      team_id: TEAM_ID,
      force: true,
    )

    set_info_plist_value(path: "ListenApp/Info.plist", key: "CFBundleVersion",
                         value: Time.now.strftime("%Y%m%d%H%M"))

    update_code_signing_settings(
      path: "Overland.xcodeproj",
      targets: ["Listen"],
      use_automatic_signing: false,
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: LISTEN_ADHOC_PROFILE_NAME,
    )

    build_app(
      project: "Overland.xcodeproj",
      scheme: "Listen",
      export_method: "ad-hoc",
      output_directory: LISTEN_ADHOC_OUTPUT_DIR,
      output_name: "Listen",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { LISTEN_ID => LISTEN_ADHOC_PROFILE_NAME },
      },
      xcargs: "CODE_SIGN_STYLE=Manual " \
              "DEVELOPMENT_TEAM=#{TEAM_ID} " \
              "CODE_SIGN_IDENTITY='Apple Distribution'",
    )

    UI.success("Listen ad hoc ipa: #{lane_context[SharedValues::IPA_OUTPUT_PATH]}")
  end

  desc "Build the standalone Quotes app as an ad-hoc signed ipa"
  lane :quotes_adhoc do
    api_key = asc_api_key

    Spaceship::ConnectAPI.auth(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key: ENV["ASC_KEY_P8"],
    )
    # The widget extension is a second bundle id (Developer Portal identifier
    # only, never an App Store Connect app record) with its own ad-hoc profile.
    [[QUOTES_ID, "Quotes"], [QUOTES_WIDGET_ID, "Quotes Widget"]].each do |identifier, name|
      if Spaceship::ConnectAPI::BundleId.find(identifier)
        UI.message("Bundle id #{identifier} is already registered")
      else
        Spaceship::ConnectAPI::BundleId.create(
          name: name,
          identifier: identifier,
          platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
        )
        UI.success("Registered bundle id #{identifier}")
      end
    end

    [[QUOTES_ID, QUOTES_ADHOC_PROFILE_NAME],
     [QUOTES_WIDGET_ID, QUOTES_WIDGET_ADHOC_PROFILE_NAME]].each do |identifier, name|
      get_provisioning_profile(
        api_key: api_key,
        adhoc: true,
        app_identifier: identifier,
        provisioning_name: name,
        team_id: TEAM_ID,
        force: true,
      )
    end

    # The widget's version must equal its host app's.
    build_number = Time.now.strftime("%Y%m%d%H%M")
    ["QuotesApp/Info.plist", "QuotesWidget/Info.plist"].each do |plist|
      set_info_plist_value(path: plist, key: "CFBundleVersion", value: build_number)
    end

    # Per-target specifiers, as in `adhoc`: one xcargs value would apply to both.
    { "Quotes" => QUOTES_ADHOC_PROFILE_NAME,
      "QuotesWidget" => QUOTES_WIDGET_ADHOC_PROFILE_NAME }.each do |target, profile|
      update_code_signing_settings(
        path: "Overland.xcodeproj",
        targets: [target],
        use_automatic_signing: false,
        team_id: TEAM_ID,
        code_sign_identity: "Apple Distribution",
        profile_name: profile,
      )
    end

    build_app(
      project: "Overland.xcodeproj",
      scheme: "Quotes",
      export_method: "ad-hoc",
      output_directory: QUOTES_ADHOC_OUTPUT_DIR,
      output_name: "Quotes",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          QUOTES_ID => QUOTES_ADHOC_PROFILE_NAME,
          QUOTES_WIDGET_ID => QUOTES_WIDGET_ADHOC_PROFILE_NAME,
        },
      },
      xcargs: "CODE_SIGN_STYLE=Manual " \
              "DEVELOPMENT_TEAM=#{TEAM_ID} " \
              "CODE_SIGN_IDENTITY='Apple Distribution'",
    )

    UI.success("Quotes ad hoc ipa: #{lane_context[SharedValues::IPA_OUTPUT_PATH]}")
  end

  desc "Build the standalone Marketplace app (push-enabled) as an ad-hoc signed ipa"
  lane :marketplace_adhoc do
    api_key = asc_api_key

    Spaceship::ConnectAPI.auth(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key: ENV["ASC_KEY_P8"],
    )
    bundle_id = Spaceship::ConnectAPI::BundleId.find(MARKETPLACE_ID)
    if bundle_id
      UI.message("Bundle id #{MARKETPLACE_ID} is already registered")
    else
      bundle_id = Spaceship::ConnectAPI::BundleId.create(
        name: "Marketplace",
        identifier: MARKETPLACE_ID,
        platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
      )
      UI.success("Registered bundle id #{MARKETPLACE_ID}")
    end

    # aps-environment in Marketplace.entitlements needs the Push Notifications
    # capability on the App ID, and it must be enabled BEFORE the profile is
    # generated (the profile snapshots the App ID's entitlements; hence force: true below).
    push = Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS
    if bundle_id.get_capabilities.any? { |c| c.is_type?(push) }
      UI.message("#{MARKETPLACE_ID} already has #{push}")
    else
      bundle_id.create_capability(push)
      UI.success("Enabled #{push} on #{MARKETPLACE_ID}")
    end

    get_provisioning_profile(
      api_key: api_key,
      adhoc: true,
      app_identifier: MARKETPLACE_ID,
      provisioning_name: MARKETPLACE_ADHOC_PROFILE_NAME,
      team_id: TEAM_ID,
      force: true,
    )

    set_info_plist_value(path: "MarketplaceApp/Info.plist", key: "CFBundleVersion",
                         value: Time.now.strftime("%Y%m%d%H%M"))

    update_code_signing_settings(
      path: "Overland.xcodeproj",
      targets: ["Marketplace"],
      use_automatic_signing: false,
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: MARKETPLACE_ADHOC_PROFILE_NAME,
    )

    build_app(
      project: "Overland.xcodeproj",
      scheme: "Marketplace",
      export_method: "ad-hoc",
      output_directory: MARKETPLACE_ADHOC_OUTPUT_DIR,
      output_name: "Marketplace",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { MARKETPLACE_ID => MARKETPLACE_ADHOC_PROFILE_NAME },
      },
      xcargs: "CODE_SIGN_STYLE=Manual " \
              "DEVELOPMENT_TEAM=#{TEAM_ID} " \
              "CODE_SIGN_IDENTITY='Apple Distribution'",
    )

    UI.success("Marketplace ad hoc ipa: #{lane_context[SharedValues::IPA_OUTPUT_PATH]}")
  end

  desc "Build the throwaway Due Spike app (push + time-sensitive + Notification Service Extension) as an ad-hoc ipa"
  lane :duespike_adhoc do
    api_key = asc_api_key

    Spaceship::ConnectAPI.auth(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key: ENV["ASC_KEY_P8"],
    )
    # Capabilities must be on the App ID BEFORE the profile is generated (the
    # profile snapshots them; hence force: true below). The ASC API has no
    # time-sensitive capability type (run 39265471161 rejected it), so that
    # entitlement is only declared in the .entitlements file.
    push = Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS
    [[DUESPIKE_ID, "Due Spike", [push]],
     [DUESPIKE_NSE_ID, "Due Spike NSE", []]].each do |identifier, name, caps|
      bundle_id = Spaceship::ConnectAPI::BundleId.find(identifier)
      if bundle_id
        UI.message("Bundle id #{identifier} is already registered")
      else
        bundle_id = Spaceship::ConnectAPI::BundleId.create(
          name: name,
          identifier: identifier,
          platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
        )
        UI.success("Registered bundle id #{identifier}")
      end
      existing = bundle_id.get_capabilities.map(&:capability_type)
      UI.message("#{identifier} capabilities: #{existing.inspect}")
      caps.each do |cap|
        if existing.include?(cap)
          UI.message("#{identifier} already has #{cap}")
        else
          bundle_id.create_capability(cap)
          UI.success("Enabled #{cap} on #{identifier}")
        end
      end
    end

    [[DUESPIKE_ID, DUESPIKE_ADHOC_PROFILE_NAME],
     [DUESPIKE_NSE_ID, DUESPIKE_NSE_ADHOC_PROFILE_NAME]].each do |identifier, name|
      get_provisioning_profile(
        api_key: api_key,
        adhoc: true,
        app_identifier: identifier,
        provisioning_name: name,
        team_id: TEAM_ID,
        force: true,
      )
    end

    build_number = Time.now.strftime("%Y%m%d%H%M")
    ["DueSpikeApp/Info.plist", "DueSpikeNSE/Info.plist"].each do |plist|
      set_info_plist_value(path: plist, key: "CFBundleVersion", value: build_number)
    end

    { "DueSpike" => DUESPIKE_ADHOC_PROFILE_NAME,
      "DueSpikeNSE" => DUESPIKE_NSE_ADHOC_PROFILE_NAME }.each do |target, profile|
      update_code_signing_settings(
        path: "Overland.xcodeproj",
        targets: [target],
        use_automatic_signing: false,
        team_id: TEAM_ID,
        code_sign_identity: "Apple Distribution",
        profile_name: profile,
      )
    end

    build_app(
      project: "Overland.xcodeproj",
      scheme: "DueSpike",
      export_method: "ad-hoc",
      output_directory: DUESPIKE_ADHOC_OUTPUT_DIR,
      output_name: "DueSpike",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          DUESPIKE_ID => DUESPIKE_ADHOC_PROFILE_NAME,
          DUESPIKE_NSE_ID => DUESPIKE_NSE_ADHOC_PROFILE_NAME,
        },
      },
      xcargs: "CODE_SIGN_STYLE=Manual " \
              "DEVELOPMENT_TEAM=#{TEAM_ID} " \
              "CODE_SIGN_IDENTITY='Apple Distribution'",
    )

    UI.success("Due Spike ad hoc ipa: #{lane_context[SharedValues::IPA_OUTPUT_PATH]}")
  end

  desc "Build the standalone Gripes app (no push, no extensions) as an ad-hoc signed ipa"
  lane :gripes_adhoc do
    api_key = asc_api_key

    Spaceship::ConnectAPI.auth(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key: ENV["ASC_KEY_P8"],
    )
    if Spaceship::ConnectAPI::BundleId.find(GRIPES_ID)
      UI.message("Bundle id #{GRIPES_ID} is already registered")
    else
      Spaceship::ConnectAPI::BundleId.create(
        name: "Gripes",
        identifier: GRIPES_ID,
        platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
      )
      UI.success("Registered bundle id #{GRIPES_ID}")
    end

    get_provisioning_profile(
      api_key: api_key,
      adhoc: true,
      app_identifier: GRIPES_ID,
      provisioning_name: GRIPES_ADHOC_PROFILE_NAME,
      team_id: TEAM_ID,
      force: true,
    )

    set_info_plist_value(path: "GripesApp/Info.plist", key: "CFBundleVersion",
                         value: Time.now.strftime("%Y%m%d%H%M"))

    update_code_signing_settings(
      path: "Overland.xcodeproj",
      targets: ["Gripes"],
      use_automatic_signing: false,
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: GRIPES_ADHOC_PROFILE_NAME,
    )

    build_app(
      project: "Overland.xcodeproj",
      scheme: "Gripes",
      export_method: "ad-hoc",
      output_directory: GRIPES_ADHOC_OUTPUT_DIR,
      output_name: "Gripes",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { GRIPES_ID => GRIPES_ADHOC_PROFILE_NAME },
      },
      xcargs: "CODE_SIGN_STYLE=Manual " \
              "DEVELOPMENT_TEAM=#{TEAM_ID} " \
              "CODE_SIGN_IDENTITY='Apple Distribution'",
    )

    UI.success("Gripes ad hoc ipa: #{lane_context[SharedValues::IPA_OUTPUT_PATH]}")
  end

  # The embedded CycleNSE needs its own app id (no capabilities) before its profile can be generated.
  # Called after the calling lane has authenticated Spaceship.
  private_lane :ensure_cycle_nse_bundle_id do
    if Spaceship::ConnectAPI::BundleId.find(CYCLE_NSE_ID)
      UI.message("Bundle id #{CYCLE_NSE_ID} is already registered")
    else
      Spaceship::ConnectAPI::BundleId.create(
        name: "Cycle NSE",
        identifier: CYCLE_NSE_ID,
        platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
      )
      UI.success("Registered bundle id #{CYCLE_NSE_ID}")
    end
  end


  desc "Build the standalone Cycle app (push + delivery-receipt Notification Service Extension) as an ad-hoc signed ipa"
  lane :cycle_adhoc do
    api_key = asc_api_key

    Spaceship::ConnectAPI.auth(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key: ENV["ASC_KEY_P8"],
    )
    bundle_id = Spaceship::ConnectAPI::BundleId.find(CYCLE_ID)
    if bundle_id
      UI.message("Bundle id #{CYCLE_ID} is already registered")
    else
      bundle_id = Spaceship::ConnectAPI::BundleId.create(
        name: "Cycle",
        identifier: CYCLE_ID,
        platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
      )
      UI.success("Registered bundle id #{CYCLE_ID}")
    end

    # aps-environment in Cycle.entitlements needs the Push Notifications capability on the
    # App ID, enabled BEFORE the profile is generated (the profile snapshots the App ID's
    # entitlements; hence force: true below).
    push = Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS
    if bundle_id.get_capabilities.any? { |c| c.is_type?(push) }
      UI.message("#{CYCLE_ID} already has #{push}")
    else
      bundle_id.create_capability(push)
      UI.success("Enabled #{push} on #{CYCLE_ID}")
    end

    ensure_cycle_nse_bundle_id

    [[CYCLE_ID, CYCLE_ADHOC_PROFILE_NAME], [CYCLE_NSE_ID, CYCLE_NSE_ADHOC_PROFILE_NAME]].each do |identifier, name|
      get_provisioning_profile(
        api_key: api_key,
        adhoc: true,
        app_identifier: identifier,
        provisioning_name: name,
        team_id: TEAM_ID,
        force: true,
      )
    end

    # An embedded extension must carry the same CFBundleVersion as its app.
    build_number = Time.now.strftime("%Y%m%d%H%M")
    ["CycleApp/Info.plist", "CycleNSE/Info.plist"].each do |plist|
      set_info_plist_value(path: plist, key: "CFBundleVersion", value: build_number)
    end

    { "Cycle" => CYCLE_ADHOC_PROFILE_NAME, "CycleNSE" => CYCLE_NSE_ADHOC_PROFILE_NAME }.each do |target, profile|
      update_code_signing_settings(
        path: "Overland.xcodeproj",
        targets: [target],
        use_automatic_signing: false,
        team_id: TEAM_ID,
        code_sign_identity: "Apple Distribution",
        profile_name: profile,
      )
    end

    build_app(
      project: "Overland.xcodeproj",
      scheme: "Cycle",
      export_method: "ad-hoc",
      output_directory: CYCLE_ADHOC_OUTPUT_DIR,
      output_name: "Cycle",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { CYCLE_ID => CYCLE_ADHOC_PROFILE_NAME, CYCLE_NSE_ID => CYCLE_NSE_ADHOC_PROFILE_NAME },
      },
      xcargs: "CODE_SIGN_STYLE=Manual " \
              "DEVELOPMENT_TEAM=#{TEAM_ID} " \
              "CODE_SIGN_IDENTITY='Apple Distribution'",
    )

    UI.success("Cycle ad hoc ipa: #{lane_context[SharedValues::IPA_OUTPUT_PATH]}")
  end

  desc "Build the standalone Cycle app for the App Store and upload to TestFlight"
  lane :cycle_beta do
    api_key = asc_api_key

    Spaceship::ConnectAPI.auth(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key: ENV["ASC_KEY_P8"],
    )
    # The App Store Connect API cannot create an app record (and `produce` needs an interactive
    # Apple ID login), so the record is a one-time manual step; fail before building anything.
    app = Spaceship::ConnectAPI::App.find(CYCLE_ID)
    UI.user_error!("No App Store Connect app record for #{CYCLE_ID}. Create it once in App Store Connect " \
                   "(My Apps > + > New App, bundle id #{CYCLE_ID}); the API cannot do this.") unless app

    bundle_id = Spaceship::ConnectAPI::BundleId.find(CYCLE_ID)
    if bundle_id
      UI.message("Bundle id #{CYCLE_ID} is already registered")
    else
      bundle_id = Spaceship::ConnectAPI::BundleId.create(
        name: "Cycle",
        identifier: CYCLE_ID,
        platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
      )
      UI.success("Registered bundle id #{CYCLE_ID}")
    end

    # aps-environment in Cycle.entitlements needs the Push Notifications capability on the
    # App ID, enabled BEFORE the profile is generated (the profile snapshots the App ID's
    # entitlements; hence force: true below).
    push = Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS
    if bundle_id.get_capabilities.any? { |c| c.is_type?(push) }
      UI.message("#{CYCLE_ID} already has #{push}")
    else
      bundle_id.create_capability(push)
      UI.success("Enabled #{push} on #{CYCLE_ID}")
    end

    ensure_cycle_nse_bundle_id

    [[CYCLE_ID, CYCLE_APPSTORE_PROFILE_NAME], [CYCLE_NSE_ID, CYCLE_NSE_APPSTORE_PROFILE_NAME]].each do |identifier, name|
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: identifier,
        provisioning_name: name,
        team_id: TEAM_ID,
        readonly: false,
        force: true,
      )
    end

    # An embedded extension must carry the same CFBundleVersion as its app.
    build_number = Time.now.strftime("%Y%m%d%H%M")
    ["CycleApp/Info.plist", "CycleNSE/Info.plist"].each do |plist|
      set_info_plist_value(path: plist, key: "CFBundleVersion", value: build_number)
    end

    { "Cycle" => CYCLE_APPSTORE_PROFILE_NAME, "CycleNSE" => CYCLE_NSE_APPSTORE_PROFILE_NAME }.each do |target, profile|
      update_code_signing_settings(
        path: "Overland.xcodeproj",
        targets: [target],
        use_automatic_signing: false,
        team_id: TEAM_ID,
        code_sign_identity: "Apple Distribution",
        profile_name: profile,
      )
    end

    build_app(
      project: "Overland.xcodeproj",
      scheme: "Cycle",
      export_method: "app-store",
      output_directory: "build/appstore-cycle",
      output_name: "Cycle",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { CYCLE_ID => CYCLE_APPSTORE_PROFILE_NAME, CYCLE_NSE_ID => CYCLE_NSE_APPSTORE_PROFILE_NAME },
      },
      xcargs: "CODE_SIGN_STYLE=Manual " \
              "DEVELOPMENT_TEAM=#{TEAM_ID} " \
              "CODE_SIGN_IDENTITY='Apple Distribution'",
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: CYCLE_ID,
      skip_waiting_for_build_processing: true,
    )

    # Same as goals_beta: assign the group while the build is still PROCESSING. Submitting the
    # build for beta review (needed once for an external group) is left to a human.
    group = app.get_beta_groups.find { |g| g.name == CYCLE_GROUP }
    unless group
      group = app.create_beta_group(group_name: CYCLE_GROUP, public_link_enabled: true)
      UI.success("Created external beta group #{CYCLE_GROUP.inspect}")
    end

    build = nil
    30.times do
      build = Spaceship::ConnectAPI::Build.all(app_id: app.id, build_number: build_number).first
      break if build
      sleep(20)
    end
    UI.user_error!("Build #{build_number} never appeared in App Store Connect") unless build

    build.add_beta_groups(beta_groups: [group])
    UI.success("Build #{build_number} assigned to beta group #{CYCLE_GROUP.inspect}")
  end

  desc "Build the standalone Goals app (WKWebView wrapper) for the App Store and upload to TestFlight"
  lane :goals_beta do
    api_key = asc_api_key

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: GOALS_ID,
      provisioning_name: GOALS_APPSTORE_PROFILE_NAME,
      team_id: TEAM_ID,
      readonly: false,
    )

    build_number = Time.now.strftime("%Y%m%d%H%M")
    set_info_plist_value(path: "GoalsApp/Info.plist", key: "CFBundleVersion", value: build_number)

    update_code_signing_settings(
      path: "Overland.xcodeproj",
      targets: ["Goals"],
      use_automatic_signing: false,
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: GOALS_APPSTORE_PROFILE_NAME,
    )

    build_app(
      project: "Overland.xcodeproj",
      scheme: "Goals",
      export_method: "app-store",
      output_directory: "build/appstore-goals",
      output_name: "Goals",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { GOALS_ID => GOALS_APPSTORE_PROFILE_NAME },
      },
      xcargs: "CODE_SIGN_STYLE=Manual " \
              "DEVELOPMENT_TEAM=#{TEAM_ID} " \
              "CODE_SIGN_IDENTITY='Apple Distribution'",
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: GOALS_ID,
      skip_waiting_for_build_processing: true,
    )

    # Same reasoning as the `beta` lane: assign the group right after upload, while the build is
    # still PROCESSING. The group is EXTERNAL with a public link; submitting the build for beta
    # review is deliberately left to a human.
    app = Spaceship::ConnectAPI::App.find(GOALS_ID)
    UI.user_error!("No App Store Connect app record for #{GOALS_ID}") unless app
    group = app.get_beta_groups.find { |g| g.name == GOALS_GROUP }
    unless group
      group = app.create_beta_group(group_name: GOALS_GROUP, public_link_enabled: true)
      UI.success("Created external beta group #{GOALS_GROUP.inspect}")
    end

    build = nil
    30.times do
      build = Spaceship::ConnectAPI::Build.all(app_id: app.id, build_number: build_number).first
      break if build
      sleep(20)
    end
    UI.user_error!("Build #{build_number} never appeared in App Store Connect") unless build

    build.add_beta_groups(beta_groups: [group])
    UI.success("Build #{build_number} assigned to beta group #{GOALS_GROUP.inspect}")
  end

  desc "Build the guest Listen app (Listen target, com.oliverullman.listenguest) and upload to TestFlight"
  lane :listen_guest_beta do
    api_key = asc_api_key

    Spaceship::ConnectAPI.auth(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key: ENV["ASC_KEY_P8"],
    )
    app = Spaceship::ConnectAPI::App.find(LISTEN_GUEST_ID)
    UI.user_error!("No App Store Connect app record for #{LISTEN_GUEST_ID}. Create it once in App Store Connect " \
                   "(My Apps > + > New App, bundle id #{LISTEN_GUEST_ID}); the API cannot do this.") unless app

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: LISTEN_GUEST_ID,
      provisioning_name: LISTEN_GUEST_APPSTORE_PROFILE_NAME,
      team_id: TEAM_ID,
      readonly: false,
    )

    build_number = Time.now.strftime("%Y%m%d%H%M")
    set_info_plist_value(path: "ListenApp/Info.plist", key: "CFBundleVersion", value: build_number)

    update_code_signing_settings(
      path: "Overland.xcodeproj",
      targets: ["Listen"],
      use_automatic_signing: false,
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: LISTEN_GUEST_APPSTORE_PROFILE_NAME,
      bundle_identifier: LISTEN_GUEST_ID,
    )

    build_app(
      project: "Overland.xcodeproj",
      scheme: "Listen",
      export_method: "app-store",
      output_directory: "build/appstore-listen-guest",
      output_name: "Listen",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { LISTEN_GUEST_ID => LISTEN_GUEST_APPSTORE_PROFILE_NAME },
      },
      xcargs: "CODE_SIGN_STYLE=Manual " \
              "DEVELOPMENT_TEAM=#{TEAM_ID} " \
              "CODE_SIGN_IDENTITY='Apple Distribution' " \
              "PRODUCT_BUNDLE_IDENTIFIER=#{LISTEN_GUEST_ID}",
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: LISTEN_GUEST_ID,
      skip_waiting_for_build_processing: true,
    )

    # Same as goals_beta: assign the group while the build is still PROCESSING; the public link is shared by hand.
    group = app.get_beta_groups.find { |g| g.name == LISTEN_GUEST_GROUP }
    unless group
      group = app.create_beta_group(group_name: LISTEN_GUEST_GROUP, public_link_enabled: true)
      UI.success("Created external beta group #{LISTEN_GUEST_GROUP.inspect}")
    end

    build = nil
    30.times do
      build = Spaceship::ConnectAPI::Build.all(app_id: app.id, build_number: build_number).first
      break if build
      sleep(20)
    end
    UI.user_error!("Build #{build_number} never appeared in App Store Connect") unless build

    build.add_beta_groups(beta_groups: [group])
    UI.success("Build #{build_number} assigned to beta group #{LISTEN_GUEST_GROUP.inspect}")
  end

  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
    )
  end

  # The share extension and the journal Control are each a second bundle id
  # and need their own App ID plus their own provisioning profile. They get a
  # Developer Portal identifier only — an extension must never get an App
  # Store Connect app record.
  #
  # This talks to Spaceship directly rather than using `produce`, which still
  # authenticates through the legacy Apple ID login and so asks for a password
  # the runner does not have; the App Store Connect API key works here.
  private_lane :ensure_ext_bundle_id do
    Spaceship::ConnectAPI.auth(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key: ENV["ASC_KEY_P8"],
    )
    [[EXT_ID, "Assistant Location Share"],
     [VOICE_ID, "Assistant Location Voice"],
     [CTL_ID, "Assistant Location Journal Control"]].each do |identifier, name|
      existing = Spaceship::ConnectAPI::BundleId.find(identifier)
      if existing
        UI.message("Bundle id #{identifier} is already registered")
      else
        Spaceship::ConnectAPI::BundleId.create(
          name: name,
          identifier: identifier,
          platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
        )
        UI.success("Registered bundle id #{identifier}")
      end
    end
  end

  # Returns the build number it stamped.
  private_lane :stamp_build_number do
    # Monotonic build number so TestFlight never rejects a duplicate/lower one.
    # Every extension MUST carry the same CFBundleVersion (and the same
    # CFBundleShortVersionString, which all three plists pin to 1.3) as the
    # app, or the upload fails validation.
    build_number = Time.now.strftime("%Y%m%d%H%M")
    ["App/Info.plist", "ShareToDesktop/Info.plist", "VoiceToDesktop/Info.plist",
     "JournalControl/Info.plist"].each do |plist|
      set_info_plist_value(path: plist, key: "CFBundleVersion", value: build_number)
    end

    # Build identity on the home screen itself: every build has carried version
    # 1.3, so without this the icon label cannot distinguish installs. Derived
    # from build_number so it cannot go stale ("T0802-0117" == 202608020117),
    # and kept to 10 chars so iOS does not truncate it under the icon.
    display_name = "T#{build_number[4, 4]}-#{build_number[8, 4]}"
    set_info_plist_value(path: "App/Info.plist",
                         key: "CFBundleDisplayName",
                         value: display_name)
    UI.success("Home-screen display name for this build: #{display_name}")

    build_number
  end
end
